{
  "compilerOptions": {
    "target": "ES2024",

    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "types": ["node"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,

    "isolatedModules": true,
    "resolveJsonModule": true,

    "noEmit": true,
    "skipLibCheck": true,

    "paths": {
      "@tests/*": ["./tests/*"]
    }
  },

  "include": [
    "playwright.config.ts",
    "tests/**/*.ts"
  ],

  "exclude": [
    "node_modules",
    "test-results",
    "playwright-report",
    "blob-report"
  ]
}
